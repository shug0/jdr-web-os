# Admin App Environment Variables
# Copy this file to .env.local and fill in your actual values

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3003

# Supabase Configuration
# For local development, use the default Supabase local keys (generated by `supabase start`)
# For production, get your keys from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Notion Integration Token
# Create an integration at: https://www.notion.so/my-integrations
NOTION_API_KEY=ntn_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
NOTION_TOKEN=ntn_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
